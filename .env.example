# Findgloed local environment
# Apple Silicon M3 + Docker-only local development

# ---------- Runtime ----------
APP_ENV=development
APP_NAME=findgloed

# ---------- Nonstandard ports (39xxx range, suffix 563-568 = "GLOD" på keypad) ----------
# 39xxx er sjældent brugt af andre dev-services, men under 49152 (OS ephemeral).
APP_PORT=39563
API_PORT=39564
POSTGRES_PORT=39565
REDIS_PORT=39566
MAILDEV_PORT=39567
ADMINER_PORT=39568

# ---------- App URLs ----------
APP_URL=http://localhost:39563
API_URL=http://localhost:39564
CORS_ORIGINS=http://localhost:39563

# ---------- Frontend feature flags ----------
VITE_ENABLE_DESIGN_PAGE=true
VITE_THEME_PRESET=anthro-v1

# ---------- Waitlist / Consent ----------
WAITLIST_CONFIRM_PATH=/waitlist/confirm
PARTNER_CONFIRM_PATH=/partner/confirm
WAITLIST_CONFIRM_TOKEN_TTL_HOURS=72
WAITLIST_RESEND_COOLDOWN_MINUTES=15

# ---------- Rate limiting ----------
REDIS_URL=redis://redis:6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
# In production this should be false.
RATE_LIMIT_WAITLIST_MAX=5
RATE_LIMIT_WAITLIST_WINDOW_SECONDS=60
RATE_LIMIT_CONFIRM_MAX=10
RATE_LIMIT_CONFIRM_WINDOW_SECONDS=60
# Per-scope rate-limits (issue B13). Bucketet på fingerprint+email for login,
# på userId for de authenticated scopes.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_MESSAGE_MAX=30
RATE_LIMIT_MESSAGE_WINDOW_SECONDS=60
RATE_LIMIT_INTEREST_MAX=20
RATE_LIMIT_INTEREST_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
TRUST_PROXY=false

# ---------- Article search ----------
# Meilisearch is only reachable inside Docker. Use a URL-safe secret of at
# least 16 bytes; never expose it through PUBLIC_* or VITE_* variables.
MEILI_MASTER_KEY=replace_with_url_safe_meili_master_key
MEILI_ARTICLE_INDEX=articles

# ---------- Database ----------
POSTGRES_DB=findgloed
POSTGRES_USER=findgloed
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://findgloed:change_me@localhost:39565/findgloed
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# ---------- Auth (Idura / MitID) ----------
IDURA_BASE_URL=https://idura.eu
IDURA_ISSUER_URL=
IDURA_CLIENT_ID=
IDURA_CLIENT_SECRET=
IDURA_REDIRECT_URI=http://localhost:39564/auth/callback
BETTER_AUTH_URL=http://localhost:39564
BETTER_AUTH_SECRET=replace_with_url_safe_32_chars_min
ADMIN_EMAILS=admin@findgloed.dk
SUPERADMIN_EMAIL=admin@findgloed.dk
SUPERADMIN_PASSWORD=replace_with_admin_password_min_8_chars

# ---------- Email (Resend) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

# ---------- GDPR dataansvar (issue A19) ----------
# Navngiven dataansvarlig. Vises i privacy-policy + email-signaturer.
DATA_CONTROLLER_NAME="Mikkel Freltoft Krogsholm"
DATA_CONTROLLER_EMAIL=mikkel@findgloed.dk

# ---------- Payments (Stripe) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Security ----------
# Use URL-safe secrets (letters, numbers, _, -) to avoid Docker Compose interpolation issues.
JWT_SECRET=replace_with_long_random_value
ENCRYPTION_KEY=replace_with_32_char_min_value
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000

# ---------- Health/ops ----------
HEALTHCHECK_PATH=/api/health
