{
	email {$ACME_EMAIL}
}

# Genbrugelige security headers — anvendes med `import security_headers`.
# HSTS sættes her i Caddy (proxy-laget) og IKKE i applikationen, så vi har
# ét sted at justere TTL og preload. Api skal derfor køre med ENABLE_HSTS=false.
(security_headers) {
	header {
		# 1 år, includeSubDomains. Preload kan tilføjes når domænet er
		# klar til submission på hstspreload.org.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Forhindrer MIME-sniffing-angreb.
		X-Content-Type-Options "nosniff"
		# Vi tillader ikke embedding i frames (clickjacking-beskyttelse).
		X-Frame-Options "DENY"
		# Lækker kun origin på cross-origin requests (ikke fuld URL).
		Referrer-Policy "strict-origin-when-cross-origin"
		# Drop sensors vi ikke bruger. Tilføj 'self' her hvis vi senere
		# har brug for en sensor i en specifik feature.
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		# Caddy sætter default en "Server: Caddy" header — fjern den
		# så vi ikke afslører proxy-type.
		-Server
	}
}

findgloed.dk, www.findgloed.dk {
	import security_headers

	# First-party Umami tracker; handle_path strips /a before proxying.
	handle_path /a/* {
		reverse_proxy umami:3000
	}

	# Private medlemsruter hører til den isolerede app.
	@private path /mit-gloed /mit-gloed/* /login /login/*
	redir @private https://app.findgloed.dk{uri} 308

	# Søgning går via Hono-proxyen; Meilisearch er aldrig offentligt eksponeret.
	@article_search path /api/search/articles
	reverse_proxy @article_search api:39564

	# Det offentlige Astro-site.
	reverse_proxy findgloed-astro:4321
}

api.findgloed.dk {
	import security_headers
	reverse_proxy api:39564
}

umami.findgloed.dk {
	import security_headers
	reverse_proxy umami:3000
}

app.findgloed.dk {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		-Server
	}

	@new_app_private path /api/me /api/me/*
	header @new_app_private Cache-Control "private, no-store"

	@new_app_api path /api /api/*
	reverse_proxy @new_app_api findgloed-app-api:39564
	reverse_proxy findgloed-app-web:80
}
